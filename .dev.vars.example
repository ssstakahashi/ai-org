# ローカル用。必要ならシークレットを追加
# EXAMPLE_SECRET=value

# Server Action ID をデプロイ間で安定させる（ビルド時のみ・本番 runtime 不要）
# 初回: openssl rand -base64 32 で生成し、以降ずっと同じ値を使う
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# X API（投稿用・値はコンソールから取得）
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# X_BEARER_TOKEN=

# agri 等からの自動化 push 受信
# AUTOMATION_INGEST_SECRET=

# X投稿 → Google スプレッドシート転記（Service Account）
# 1. Google Cloud で Sheets API を有効化し Service Account を作成
# 2. 転記先シートを SA の client_email に「編集者」で共有
# 3. 秘密鍵 JSON の client_email / private_key を設定
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# APP_PUBLIC_URL=https://your-ai-org.example.com

# X投稿の画像解析（Google AI Studio / Gemini API）
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
