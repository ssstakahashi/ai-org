/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-org",
	"main": "worker.ts",
	"compatibility_date": "2026-08-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets",
		// Skew Protection 有効時は Worker が先に実行され、デプロイ前後の JS と Server Action を揃える
		"run_worker_first": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ai-org"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ai-org",
			"database_id": "34b349f2-ca97-4ecc-9540-c04e7c9e2696",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "ai-org-media"
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	// @automation id: x-due-cron — 詳細は worker.ts の scheduled
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"vars": {
		"CF_WORKER_NAME": "ai-org",
		"CF_ACCOUNT_ID": "2416397d79e09c5f8f8afd5b2ed379db"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
